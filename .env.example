# ParkWatch backend (Supabase) configuration. Copy to `.env` and fill in.
# Both values are PUBLIC client values (Project Settings -> API in Supabase).
# Leave them empty to run the local demo without any backend.
#
# NEVER put a secret or server-only key (Supabase "service" key) in this file or in the
# app: everything prefixed EXPO_PUBLIC_ is bundled into the mobile app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
