{
  "name": "parkwatch-mvp",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "test": "jest",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "mock:backend": "node scripts/mock-supabase-backend.mjs",
    "test:cloud-smoke": "node scripts/cloud-smoke.mjs",
    "test:cloud-qa": "jest --runInBand --testTimeout=60000 --testMatch \"**/__cloudqa__/**/*.cloudqa.ts\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.117.2",
    "expo": "~57.0.26",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/jest": "29.5.14",
    "@types/node": "~26.6",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=20.19.4"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ]
  }
}
