# recognize-plate Edge Function secrets - NAMES ONLY. Never commit real values.
# Set them on the project with:  npx supabase secrets set --env-file supabase/functions/.env
# (the real .env file is git-ignored). For local `supabase functions serve`, use the same file.
PLATE_RECOGNITION_PROVIDER=platerecognizer
PLATE_RECOGNIZER_API_TOKEN=

# push-dispatch Edge Function (T9.2) - NAMES ONLY.
# PUSH_DISPATCH_SECRET: random, >= 32 characters; the same value is given to the
# Database Webhook / scheduled caller as header x-parkwatch-dispatch-secret.
PUSH_DISPATCH_SECRET=
# Optional: only if "enhanced push security" is enabled for the Expo project.
EXPO_ACCESS_TOKEN=
